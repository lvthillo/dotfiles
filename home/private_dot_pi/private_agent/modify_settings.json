{{- /* chezmoi:modify-template */ -}}
{{- /* Overlay managed keys onto the live file; keys pi owns (lastChangelogVersion,
       installed package metadata) pass through. Package sources stay listed so the
       set converges declaratively; pi install resolves them to full entries. */ -}}
{{- $current := dict -}}
{{- if .chezmoi.stdin -}}
{{-   $current = fromJson .chezmoi.stdin -}}
{{- end -}}
{{- $managed := dict
      "theme" "dark"
      "defaultProvider" "openai-codex"
      "defaultModel" "gpt-5.5"
      "packages" (list "git:github.com/samfoy/pi-lsp-extension")
-}}
{{- mergeOverwrite $current $managed | toPrettyJson -}}
